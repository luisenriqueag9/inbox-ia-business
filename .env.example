# Inbox IA Business — Variables de entorno
# Copia este archivo a .env y completa los valores antes de ejecutar el proyecto.
# Nunca versiones .env ni coloques credenciales reales en este archivo.

# ─── PostgreSQL (requerido desde v0.0.2) ──────────────────────────────────────
# Nombre de la base de datos de desarrollo local.
POSTGRES_DB=inbox_ia_dev

# Usuario de PostgreSQL para desarrollo local.
POSTGRES_USER=inbox_user

# Contrasena de PostgreSQL. Cambia este valor por uno seguro antes de usar.
POSTGRES_PASSWORD=cambia_esta_contrasena

# URL de conexion completa para el backend (construida a partir de las variables anteriores).
DATABASE_URL=postgresql://inbox_user:cambia_esta_contrasena@localhost:5432/inbox_ia_dev

# ─── Notas ────────────────────────────────────────────────────────────────────
# SECRET_KEY y otras variables de autenticacion se agregaran cuando se implemente auth.
